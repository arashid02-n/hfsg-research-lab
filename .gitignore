# HFSG Research Lab — ignore generated artifacts
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# HFSG Core is NEVER committed into the public Lab repository or package
# (IP / distribution boundary — see IP_AND_DISTRIBUTION_BOUNDARY.md).
hfsg_core/
core/
hfsg_core.config

# recorded runs (reproduced on demand; evidence stays in results/validation_evidence)
results/*
!results/validation_evidence/
!results/validation_evidence/**
outputs/
logs/

# built release packages (regenerated via scripts/build_package.py)
release/

# Gate 2A recorded benchmark / proof stores (reproducible via bench/ and proof/)
runs/
bench/runs/

# browser screenshots cache / playwright
screenshots/.cache/
node_modules/

